				Search = true,
				Callback = function(name)
					local plr = Players:FindFirstChild(name)
					if plr and pcfg.Callback then
						task.spawn(pcfg.Callback, plr)
					end
				end,
			})

			Players.PlayerAdded:Connect(function()
				dropdown:Refresh(getNames())
			end)
			Players.PlayerRemoving:Connect(function()
				dropdown:Refresh(getNames())
			end)

			local api = {}
			function api:Get()
				local name = dropdown:Get()
				return name and Players:FindFirstChild(name) or nil
			end
			function api:Set(plr)
				if plr then dropdown:Set(plr.Name) else dropdown:Set(nil) end
			end
			function api:Refresh()
				dropdown:Refresh(getNames())
			end
			api.Instance = dropdown.Instance
			return api
		end


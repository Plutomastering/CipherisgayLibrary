	function Library:SetFolder(name)
		Library.Folder = name or "Vaehz"
	end

	function Library:SaveConfig(name)
		if not writefile then return false, "writefile unavailable" end
		if not name or name == "" then return false, "Name required" end

		local data = { objects = {} }
		for flag, opt in Library.Options do
			if opt.Class == "Toggle" then
				table.insert(data.objects, { type = "Toggle", flag = flag, state = opt:Get() })
			elseif opt.Class == "Slider" then
				table.insert(data.objects, { type = "Slider", flag = flag, value = opt:Get() })
			elseif opt.Class == "Input" then
				table.insert(data.objects, { type = "Input", flag = flag, text = opt:Get() })
			elseif opt.Class == "Keybind" then
				table.insert(data.objects, { type = "Keybind", flag = flag, bind = opt:Get().Name })
			elseif opt.Class == "Dropdown" then
				table.insert(data.objects, { type = "Dropdown", flag = flag, value = opt:Get() })
			elseif opt.Class == "Colorpicker" then
				local c, a = opt:Get()
				local col = typeof(c) == "Color3" and c or Color3.new(1, 1, 1)
				table.insert(data.objects, {
					type = "Colorpicker",
					flag = flag,
					color = string.format("#%02X%02X%02X", math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255)),
					alpha = a,
				})
			end
		end

		local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
		if not ok then return false, "JSON encode failed" end

		if makefolder and not isfolder(Library.Folder) then
			makefolder(Library.Folder)
		end
		if makefolder and not isfolder(Library.Folder .. "/configs") then
			makefolder(Library.Folder .. "/configs")
		end

		writefile(Library.Folder .. "/configs/" .. name .. ".json", encoded)
		return true
	end

	function Library:LoadConfig(name)
		if not readfile or not isfile then return false, "filesystem unavailable" end
		if not name or name == "" then return false, "Name required" end

		local path = Library.Folder .. "/configs/" .. name .. ".json"
		if not isfile(path) then return false, "File not found" end

		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, readfile(path))
		if not ok then return false, "JSON decode failed" end

		for _, obj in decoded.objects or {} do
			local opt = Library.Options[obj.flag]
			if not opt then continue end
			if obj.type == "Toggle" and opt.Set then
				opt:Set(obj.state)
			elseif obj.type == "Slider" and opt.Set then
				opt:Set(tonumber(obj.value) or 0)
			elseif obj.type == "Input" and opt.Set then
				opt:Set(obj.text or "")
			elseif obj.type == "Keybind" and opt.Set and obj.bind then
				opt:Set(Enum.KeyCode[obj.bind] or Enum.KeyCode.Unknown)
			elseif obj.type == "Dropdown" and opt.Set then
				opt:Set(obj.value)
			elseif obj.type == "Colorpicker" and opt.Set and obj.color then
				local r = tonumber(obj.color:sub(2, 3), 16) / 255
				local g = tonumber(obj.color:sub(4, 5), 16) / 255
				local b = tonumber(obj.color:sub(6, 7), 16) / 255
				opt:Set(Color3.new(r, g, b), obj.alpha)
			end
		end
		return true
	end

	function Library:GetConfigList()
		if not listfiles or not isfolder then return {} end
		local path = Library.Folder .. "/configs"
		if not isfolder(path) then return {} end
		local out = {}
		for _, file in listfiles(path) do
			if file:sub(-5) == ".json" then
				local name = file:match("([^/\\]+)%.json$")
				if name then table.insert(out, name) end
			end
		end
		return out
	end

	Window.Instance = BG
	return Window
end

return Library
